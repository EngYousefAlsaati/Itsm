@{
    ViewData["Title"] = "الأدوار والصلاحيات";
    var userRole = Context.Session.GetString("UserRole");
    var userEmail = Context.Session.GetString("UserEmail");

    string roleName = userRole switch
    {
        "Employee" => "موظف",
        "Technician" => "فني / مهندس",
        "Vendor" => "مدير الاستقبال",
        "Admin" => "مدير النظام",
        _ => ""
    };

    string[] can = userRole switch
    {
        "Employee" => new[]
        {
            "إنشاء تذكرة جديدة باختيار أحد مشاريع جهتك (المشروع إلزامي)",
            "إرفاق الصور والملفات التوضيحية",
            "متابعة حالة تذاكرك",
            "مراسلة مدير الاستقبال داخل التذكرة (لا يرى الفني هذه المراسلة)",
            "معرفة أن المشكلة حُلّت بعد أن يعتمد مدير الاستقبال حل الفني",
            "الاطلاع على اتفاقيات مستوى الخدمة لمشاريع جهتك",
            "تقييم الفنيين تقييماً دورياً عاماً (كل 6 أشهر أو سنوياً) ببنود عشرة، متى أتاح مدير النظام ذلك",
            "الاطلاع على تقييمات الفنيين"
        },
        "Vendor" => new[]
        {
            "الاطلاع على جميع التذاكر",
            "قبول التذكرة أو رفضها (مع ذكر سبب الرفض)",
            "تحديد مستوى التأثير للتذكرة، فيبدأ عدّاد SLA وفق اتفاقية مشروعها",
            "توجيه الفني / المهندس المختص",
            "اعتماد حل الفني وإغلاق التذكرة، أو إرجاعه للفني مع السبب",
            "مراسلة الموظف ومراسلة الفني كلٌّ في قناته",
            "الاطلاع على اتفاقيات مستوى الخدمة لجميع المشاريع",
            "تقييم الفنيين تقييماً دورياً عاماً (كل 6 أشهر أو سنوياً) ببنود عشرة، متى أتاح مدير النظام ذلك"
        },
        "Technician" => new[]
        {
            "الاطلاع على التذاكر الموجّهة إليك فقط",
            "الضغط على «تم حل المشكلة» مع التقرير والملاحظات والمرفقات، فيتوقف عدّاد SLA",
            "مراسلة مدير الاستقبال داخل التذكرة (لا يرى الموظف هذه المراسلة)",
            "الاطلاع على اتفاقيات مستوى الخدمة",
            "الاطلاع على تقييمات الفنيين"
        },
        "Admin" => new[]
        {
            "الاطلاع على جميع التذاكر وجميع المراسلات (قناة الموظف وقناة الفني)",
            "إدارة المستخدمين والعملاء (الجهات) والمشاريع",
            "إدارة اتفاقيات مستوى الخدمة لكل مشروع وتعديل أزمنتها ووصفها بالعربية والإنجليزية",
            "إتاحة التقييم للموظفين ولمدراء الاستقبال أو إيقافه، وتحديد دورة التقييم (6 أشهر أو سنة)",
            "الرد على تقييمات الفنيين وحذفها، ورؤية وسيلة تواصل المقيِّم",
            "الاطلاع على التقارير والإحصائيات"
        },
        _ => Array.Empty<string>()
    };

    string[] cannot = userRole switch
    {
        "Employee" => new[]
        {
            "تحديد مستوى التأثير أو مهلة SLA",
            "قبول التذكرة أو رفضها أو توجيه الفني",
            "الاطلاع على مراسلات الفني",
            "إنشاء تذكرة دون مشروع مسجّل لجهتك"
        },
        "Vendor" => new[]
        {
            "إنشاء تذاكر (للموظف فقط)",
            "إدارة المستخدمين والعملاء والمشاريع واتفاقيات SLA (لمدير النظام)",
            "رفع تقرير الحل (للفني المُوجَّه إليه)"
        },
        "Technician" => new[]
        {
            "إنشاء تذاكر",
            "قبول التذكرة أو رفضها أو توجيه الفني أو تحديد مستوى التأثير",
            "إغلاق التذكرة بنفسك (يعتمد مدير الاستقبال الحل أولاً)",
            "الاطلاع على مراسلات الموظف"
        },
        "Admin" => new[]
        {
            "قبول التذاكر أو رفضها أو توجيه الفني (لمدير الاستقبال وحده)",
            "اعتماد حلول الفنيين (لمدير الاستقبال وحده)",
            "إنشاء تذاكر"
        },
        _ => Array.Empty<string>()
    };
}

<div dir="rtl">
    <h3 class="mb-3">الأدوار والصلاحيات</h3>

    @if (string.IsNullOrEmpty(userRole))
    {
        <div class="alert alert-info">سجّل الدخول لعرض الدور والصلاحيات الخاصة بك.</div>
        <a asp-controller="Account" asp-action="Login" class="btn btn-success">تسجيل دخول</a>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="text-muted small">الحساب</div>
                <div class="mb-2">@userEmail</div>
                <div class="text-muted small">تصنيفك في النظام</div>
                <span class="badge bg-primary fs-6">@roleName</span>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card border-success h-100">
                    <div class="card-header bg-success text-white fw-bold">المسموح لك</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var item in can)
                        {
                            <li class="list-group-item">✅ @item</li>
                        }
                    </ul>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-danger h-100">
                    <div class="card-header bg-danger text-white fw-bold">غير مسموح لك</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var item in cannot)
                        {
                            <li class="list-group-item">⛔ @item</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header fw-bold">مسار التذكرة</div>
            <div class="card-body">
                <ol class="mb-0">
                    <li>الموظف ينشئ التذكرة ويختار مشروعه ← <span class="badge bg-secondary">بانتظار الموافقة</span></li>
                    <li>مدير الاستقبال يقبلها ويحدد مستوى التأثير ويوجّه الفني ← <span class="badge bg-primary">موجّهة للفني</span> ويبدأ عدّاد SLA بزمن الحل في اتفاقية المشروع، أو يرفضها مع السبب</li>
                    <li>الفني يعالج ويضغط «تم حل المشكلة» مع التقرير ← يتوقف العدّاد وتنتظر التذكرة اعتماد مدير الاستقبال</li>
                    <li>مدير الاستقبال يعتمد الحل ← <span class="badge bg-success">مغلقة</span> ويظهر للموظف «تم حل المشكلة»، أو يعيده للفني فيستأنف العدّاد</li>
                    <li>التقييم الدوري: كل 6 أشهر أو سنوياً (يحدد مدير النظام الدورة) يقيّم الموظف ومدير الاستقبال أداء الفني ببنود عشرة من 1 إلى 5، متى أتاح مدير النظام ذلك لفئتهم. ويطّلع الجميع على التقييمات.</li>
                </ol>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header fw-bold">مهلة المعالجة (SLA)</div>
            <div class="card-body">
                لكل مشروع اتفاقية مستوى خدمة خاصة به تحدد، لكل مستوى تأثير، زمن الاستجابة وزمن الحل.
                افتح <a asp-controller="Projects" asp-action="Agreements">اتفاقيات مستوى الخدمة</a> للاطلاع عليها.
            </div>
        </div>
    }
</div>
