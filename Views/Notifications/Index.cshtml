@model IEnumerable<Itsm.Models.Notification>
@{
    ViewData["Title"] = "الإشعارات";
    var unread = Model.Count(n => !n.IsRead);
}

<div dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">الإشعارات</h3>
        @if (unread > 0)
        {
            <form asp-action="MarkAllRead" method="post" class="m-0">
                <button type="submit" class="btn btn-outline-primary btn-sm">تحديد الكل كمقروء (@unread)</button>
            </form>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-muted text-center py-5">لا توجد إشعارات بعد.</div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var n in Model)
            {
                <a asp-action="Open" asp-route-id="@n.Id"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-start @(n.IsRead ? "" : "bg-body-secondary")">
                    <div>
                        <div class="@(n.IsRead ? "" : "fw-bold")">@n.Message</div>
                        <div class="small text-muted">@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                    </div>
                    @if (!n.IsRead)
                    {
                        <span class="badge bg-danger rounded-pill">جديد</span>
                    }
                </a>
            }
        </div>
    }
</div>
