@model List<Itsm.Models.TechnicianEvaluation>
@using Itsm.Models
@{
    ViewData["Title"] = "تقييمات الفنيين";
    var role = Context.Session.GetString("UserRole");
    var isAdmin = role == "Admin";
    var technicians = ViewBag.Technicians as List<string> ?? new List<string>();
    var pending = ViewBag.Pending as List<KeyValuePair<string, int>> ?? new List<KeyValuePair<string, int>>();
    var periods = ViewBag.Periods as List<string> ?? new List<string>();
    string currentKey = ViewBag.CurrentKey as string ?? "";
    string selectedKey = ViewBag.SelectedKey as string ?? currentKey;
    int months = ViewBag.Months is int m ? m : 6;
    bool empEnabled = ViewBag.EmployeesEnabled is true;
    bool mgrEnabled = ViewBag.ManagersEnabled is true;
    bool canRateRole = role == "Employee" || role == "Vendor";
    bool myEnabled = role == "Employee" ? empEnabled : role == "Vendor" && mgrEnabled;
    var criteria = RatingCriteria.Items;

    string StarsOf(double avg) => TicketText.Stars((int)Math.Round(avg, MidpointRounding.AwayFromZero));
    string RoleLabel(string r) => r == "Employee" ? "الموظف" : "مدير الاستقبال";

    var rows = technicians.Select(t =>
    {
        var mine = Model.Where(r => string.Equals(r.TechnicianEmail, t, StringComparison.OrdinalIgnoreCase)).ToList();
        var emp = mine.Where(r => r.EvaluatorRole == "Employee").ToList();
        var mgr = mine.Where(r => r.EvaluatorRole == "Vendor").ToList();
        double? Avg(List<TechnicianEvaluation> l) => l.Count == 0 ? (double?)null : l.Average(x => x.Average);
        var crit = Enumerable.Range(0, criteria.Length)
            .Select(i => mine.Count == 0 ? 0.0 : mine.Average(x => (double)x.GetScores().ElementAtOrDefault(i)))
            .ToList();
        return new { Tech = t, Count = mine.Count, Emp = Avg(emp), Mgr = Avg(mgr), All = Avg(mine), Crit = crit };
    }).OrderByDescending(x => x.All ?? 0).ThenBy(x => x.Tech).ToList();
}

<div dir="rtl">
    <h3 class="mb-1">تقييمات الفنيين والمهندسين</h3>
    <p class="text-muted">تقييم دوري عام لأداء الفني (وليس على تذكرة بعينها)، مرة في كل دورة. الدورة الحالية: <strong>@RatingPeriod.Label(currentKey)</strong>.</p>

    @* ---------- مدير النظام: إتاحة التقييم وتحديد الدورة ---------- *@
    @if (isAdmin)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-bold">إعدادات التقييم</div>
            <div class="card-body">
                <form asp-action="SaveSettings" method="post" class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="swEmp" name="employees" value="true" @(empEnabled ? "checked" : "") />
                            <label class="form-check-label" for="swEmp">السماح للموظفين بتقييم الفنيين</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="swMgr" name="managers" value="true" @(mgrEnabled ? "checked" : "") />
                            <label class="form-check-label" for="swMgr">السماح لمدراء الاستقبال بتقييم الفنيين</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">دورة التقييم</label>
                        <select name="periodMonths" class="form-select form-select-sm">
                            <option value="6" selected="@(months == 6)">كل 6 أشهر (يناير–يونيو، يوليو–ديسمبر)</option>
                            <option value="12" selected="@(months == 12)">مرة كل سنة</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-success">حفظ الإعدادات</button>
                    </div>
                </form>
                <div class="form-text mt-2">يقيّم الموظف ومدير الاستقبال كلٌّ على حدة ببنود عشرة، مرة واحدة لكل فني في كل دورة. ويقيّم الموظف الفنيين الذين أغلقوا له تذاكر خلال الدورة.</div>
            </div>
        </div>
    }

    @* ---------- الموظف ومدير الاستقبال: فنيون بانتظار تقييمك ---------- *@
    @if (canRateRole)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-bold bg-warning">بانتظار تقييمك في هذه الدورة</div>
            <div class="card-body">
                @if (!myEnabled)
                {
                    <div class="text-muted">التقييم غير مفعّل لفئتك حالياً، يتيحه مدير النظام.</div>
                }
                else if (!pending.Any())
                {
                    <div class="text-muted">لا يوجد فنيون بانتظار تقييمك في هذه الدورة.</div>
                }
                else
                {
                    @foreach (var p in pending)
                    {
                        <div class="border rounded p-3 mb-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <strong>@p.Key</strong>
                                <div class="small text-muted">تذاكر أُغلقت في هذه الدورة: @p.Value</div>
                            </div>
                            <a asp-action="Rate" asp-route-technician="@p.Key" class="btn btn-warning btn-sm">⭐ قيّم الفني</a>
                        </div>
                    }
                }
            </div>
        </div>
    }

    @* ---------- اختيار الدورة ---------- *@
    <form method="get" asp-action="Index" class="d-flex align-items-center gap-2 mb-3">
        <label class="mb-0 fw-bold">عرض تقييمات:</label>
        <select name="period" class="form-select form-select-sm" style="max-width:300px;" onchange="this.form.submit()">
            @foreach (var k in periods)
            {
                <option value="@k" selected="@(k == selectedKey)">@RatingPeriod.Label(k)@(k == currentKey ? " — الحالية" : "")</option>
            }
            <option value="all" selected="@(selectedKey == "all")">كل الدورات</option>
        </select>
    </form>

    @* ---------- ملخص الفنيين ---------- *@
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">ملخص تقييم الفنيين</div>
        <div class="table-responsive">
            <table class="table align-middle text-center mb-0">
                <thead class="table-light">
                    <tr>
                        <th>الفني</th>
                        <th>عدد التقييمات</th>
                        <th>من الموظفين</th>
                        <th>من مدراء الاستقبال</th>
                        <th>المتوسط العام</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        <tr>
                            <td class="text-start">
                                <details>
                                    <summary class="fw-bold">@r.Tech</summary>
                                    @if (r.Count == 0)
                                    {
                                        <div class="text-muted small mt-2">لا توجد تقييمات بعد.</div>
                                    }
                                    else
                                    {
                                        <div class="mt-2">
                                            @for (var i = 0; i < criteria.Length; i++)
                                            {
                                                <div class="d-flex align-items-center gap-2 small mb-1">
                                                    <div style="width:230px;">@criteria[i].Ar</div>
                                                    <div class="progress flex-grow-1" style="height:8px;">
                                                        <div class="progress-bar bg-warning" style="width:@((r.Crit[i] / 5.0 * 100).ToString("0"))%"></div>
                                                    </div>
                                                    <div style="width:36px;">@r.Crit[i].ToString("0.0")</div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </details>
                            </td>
                            <td>@r.Count</td>
                            <td>@(r.Emp.HasValue ? r.Emp.Value.ToString("0.0") + " / 5" : "—")</td>
                            <td>@(r.Mgr.HasValue ? r.Mgr.Value.ToString("0.0") + " / 5" : "—")</td>
                            <td>
                                @if (r.All.HasValue)
                                {
                                    <span class="text-warning fs-5">@StarsOf(r.All.Value)</span>
                                    <span class="fw-bold">@r.All.Value.ToString("0.0")</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!rows.Any())
                    {
                        <tr><td colspan="5" class="text-muted py-3">لا يوجد فنيون بعد.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ---------- جميع التقييمات (يراها الجميع) ---------- *@
    <h5 class="mb-3">التقييمات</h5>
    @if (!Model.Any())
    {
        <div class="text-muted py-3">لا توجد تقييمات في هذه الفترة.</div>
    }

    @foreach (var r in Model)
    {
        var scores = r.GetScores();
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <div>
                        <strong>@r.TechnicianEmail</strong>
                        <span class="text-muted small">— @RatingPeriod.Label(r.PeriodKey)</span>
                        <span class="badge @(r.EvaluatorRole == "Employee" ? "bg-info text-dark" : "bg-primary") ms-1">تقييم @RoleLabel(r.EvaluatorRole)</span>
                    </div>
                    <div>
                        <span class="text-warning fs-5">@StarsOf(r.Average)</span>
                        <strong>@r.Average.ToString("0.0")</strong> / 5
                    </div>
                </div>

                <div class="small mt-1">
                    المقيِّم: <strong>@r.EvaluatorName</strong>
                    @if (isAdmin)
                    {
                        <span class="text-muted">— للتواصل: @r.EvaluatorContact</span>
                    }
                </div>

                <details class="mt-2">
                    <summary class="small text-primary">تفاصيل البنود العشرة</summary>
                    <div class="row g-1 mt-1">
                        @for (var i = 0; i < criteria.Length; i++)
                        {
                            var v = i < scores.Length ? scores[i] : 0;
                            <div class="col-md-6 d-flex justify-content-between small border-bottom py-1">
                                <span>@criteria[i].Ar</span>
                                <span class="text-warning">@TicketText.Stars(v) <span class="text-body">@v</span></span>
                            </div>
                        }
                    </div>
                </details>

                @if (!string.IsNullOrWhiteSpace(r.Comment))
                {
                    <p class="mt-2 mb-1" style="white-space:pre-wrap">@r.Comment</p>
                }
                <div class="small text-muted">@r.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>

                @if (!string.IsNullOrWhiteSpace(r.AdminReply))
                {
                    <div class="alert alert-secondary mt-3 mb-0">
                        <strong>رد مدير النظام:</strong>
                        <div style="white-space:pre-wrap">@r.AdminReply</div>
                        <div class="small text-muted">@(r.AdminReplyAt?.ToString("yyyy-MM-dd HH:mm"))</div>
                    </div>
                }

                @if (isAdmin)
                {
                    <form asp-action="Reply" method="post" class="mt-3">
                        <input type="hidden" name="id" value="@r.Id" />
                        <textarea name="reply" class="form-control mb-2" rows="2" placeholder="اكتب ردك على التقييم" required>@r.AdminReply</textarea>
                        <button type="submit" class="btn btn-primary btn-sm">@(string.IsNullOrWhiteSpace(r.AdminReply) ? "إرسال الرد" : "تعديل الرد")</button>
                    </form>

                    <form asp-action="Delete" method="post" class="mt-2">
                        <input type="hidden" name="id" value="@r.Id" />
                        <button type="submit" class="btn btn-outline-danger btn-sm"
                                onclick="return confirm('حذف هذا التقييم نهائياً؟ يستطيع المقيِّم إعادة التقييم في الدورة نفسها بعد الحذف.');">
                            حذف التقييم
                        </button>
                    </form>
                }
            </div>
        </div>
    }
</div>
